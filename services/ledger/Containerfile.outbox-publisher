FROM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags='-s -w -buildid=' -o /out/outbox-publisher ./services/ledger/cmd/outbox-publisher
RUN CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags='-s -w -buildid=' -o /out/outbox-topology ./services/ledger/cmd/outbox-topology

FROM gcr.io/distroless/static-debian12:nonroot@sha256:f5b485ea962d9bd1186b2f6b3a061191539b905b82ec395de78cbfae51f20e35
COPY --from=build /out/outbox-publisher /outbox-publisher
COPY --from=build /out/outbox-topology /outbox-topology
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/outbox-publisher"]
